using NativeWeave.Data;
using NativeWeave.Database;
using NativeWeave.Query;

// Added after both restores. Ordinary managed entities, DTOs and Fluent queries
// reuse the existing metadata/native interfaces and unchanged packaged assets.
internal sealed record AddedEntity(long Number, string Label);
internal sealed record AddedDto(long Number, string Label);
internal static class AddedModels
{
    internal static async Task Verify(DataSource source)
    {
        string name = "nw_db_scope_added_" + Guid.NewGuid().ToString("N");
        await using var session = await source.OpenSessionAsync();
        await session.ExecuteAsync(SqlCommand.Create("CREATE TABLE " + name + "(number BIGINT PRIMARY KEY,label TEXT NOT NULL)", kind: SqlCommandKind.Mutation));
        try
        {
            var builder = new TableBuilder<AddedEntity>(name);
            var number = builder.Column("number", Codecs.Int64, new() { IsPrimaryKey = true });
            var label = builder.Column("label", Codecs.String);
            var table = builder.Build(row => new(row.Get(number), row.Get(label)), (row, value) => { row.Set(number, value.Number); row.Set(label, value.Label); });
            await session.InsertAsync(table, new AddedEntity(9, "ordinary edit"));
            using var query = session.From(table);
            var value = await query.WhereEqual(number, 9L)
                .Select(query.Column(number), query.Column(label), static (id, text) => new AddedDto(id, text)).SingleAsync();
            if (value != new AddedDto(9, "ordinary edit")) throw new InvalidOperationException("Added entity and Fluent DTO query failed.");
        }
        finally { await session.ExecuteAsync(SqlCommand.Create("DROP TABLE " + name, kind: SqlCommandKind.Mutation)); }
    }
}
