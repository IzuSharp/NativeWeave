<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>NativeWeave.Data.Sqlite.Tests</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifiers).aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).aot.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ApiCheck/**/*.cs" />
    <Compile Include="../ProviderProfileChecks.cs" Link="ProviderProfileChecks.cs" />
    <ProjectReference Include="../../src/Data.Sqlite/NativeWeave.Database.Sqlite.csproj" />
    <Compile Include="../../samples/api/data-sqlite/SqliteExamples.cs" Link="SqliteExamples.cs" />
  </ItemGroup>
</Project>
